# ==============================================================================
# Guardian — Variáveis de Ambiente (Exemplo Local)
# ==============================================================================

# Perfil do Spring Boot (dev, test, prod)
SPRING_PROFILES_ACTIVE=dev

# Porta da API REST do backend
SERVER_PORT=8080

# PostgreSQL + PostGIS
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=guardian
POSTGRES_USER=guardian
POSTGRES_PASSWORD=local_password

# Apache Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PORT=9092

# Segurança & JWT
JWT_SECRET=guardian_super_secret_local_key_minimum_256_bits_length_12345
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=7

# Integrações Externas
EXTERNAL_DATA_ENABLED=false
